            "sourceColumn": "dia_diem"
          }
        ],
        "lineageTag": "23a23499-78fe-4b2f-815b-c4f8eac65b24",
        "measures": [
          {
            "name": "So_ban_ghi",
            "expression": "COUNTROWS(ban_ghi)",
            "formatString": "#,0",
            "lineageTag": "8258d68f-b05b-4424-961e-c9f8e61e5c9b"
          },
          {
            "name": "So_ban_ghi_co_tinh",
            "expression": "IF(HASONEVALUE(ban_ghi[province]) && ISBLANK(SELECTEDVALUE(ban_ghi[province])), BLANK(), [So_ban_ghi])",
            "formatString": "#,0",
            "lineageTag": "de42bdc7-cf81-4b0b-a8fe-f7c058f07e5f"
          },
          {
            "name": "So_ban_ghi_co_loai",
            "expression": "IF(HASONEVALUE(ban_ghi[species]) && ISBLANK(SELECTEDVALUE(ban_ghi[species])), BLANK(), [So_ban_ghi])",
            "formatString": "#,0",
            "lineageTag": "b1038602-9588-474b-b5f0-13dad34616d1"
          },
          {
            "name": "So_loai",
            "expression": "CALCULATE(DISTINCTCOUNT(ban_ghi[species]), ban_ghi[species_level] = TRUE())",
            "formatString": "#,0",
            "lineageTag": "d4a221d2-f3bf-4076-b10f-9ca60916c858"
          },
          {
            "name": "So_ho",
            "expression": "DISTINCTCOUNTNOBLANK(ban_ghi[family])",
            "formatString": "#,0",
            "lineageTag": "a8873e06-307f-4c0a-9578-d2275ec6d703"
          },
          {
            "name": "So_tinh",
            "expression": "DISTINCTCOUNTNOBLANK(ban_ghi[province])",
            "formatString": "#,0",
            "lineageTag": "91f87310-0a78-4139-a470-b5504b5cc920"
          },
          {
            "name": "Ty_le_IUCN",
            "expression": "DIVIDE(CALCULATE([So_ban_ghi], ban_ghi[iucn_group] <> \"Chưa đánh giá\"), [So_ban_ghi])",
            "formatString": "0%",
            "lineageTag": "f0a2fc3f-6801-48af-9244-f23f4d8d885b"
          },
          {
            "name": "Ty_le_chua_danh_gia",
            "expression": "DIVIDE(CALCULATE([So_ban_ghi], ban_ghi[iucn_group] = \"Chưa đánh giá\"), [So_ban_ghi])",
            "formatString": "0%",
            "lineageTag": "bace7257-f4d3-4dbf-95f6-8555a0192d6d"
          },
          {
            "name": "So_nguy_cap",
            "expression": "CALCULATE([So_ban_ghi], ban_ghi[iucn_group] = \"Nguy cấp\")",
            "formatString": "#,0",
            "lineageTag": "286ed0ae-79bd-4f9e-8dfb-874eb39db388"
          },
          {
            "name": "Ty_le_nguy_cap",
            "expression": "DIVIDE([So_nguy_cap], [So_ban_ghi])",
            "formatString": "0%",
            "lineageTag": "9f809297-42e2-4a27-bceb-3c165cf760cf"
          },
          {
            "name": "So_nguy_cap_co_tinh",
            "expression": "IF(HASONEVALUE(ban_ghi[province]) && ISBLANK(SELECTEDVALUE(ban_ghi[province])), BLANK(), [So_nguy_cap])",
            "formatString": "#,0",
            "lineageTag": "7c9aaeaf-eb5b-4caa-853e-50a8cb6fe220"
          },
          {
            "name": "Ty_le_tieu_ban",
            "expression": "DIVIDE(CALCULATE([So_ban_ghi], ban_ghi[loai_ban_ghi] = \"Tiêu bản\"), [So_ban_ghi])",
            "formatString": "0%",
            "lineageTag": "bf6fafc9-47e6-4002-9221-ea17e31f7174"
          },
          {
            "name": "Top5_tinh_ty_le",
            "expression": [
              "VAR CoTinh = FILTER(VALUES(ban_ghi[province]), NOT ISBLANK(ban_ghi[province]))",
              "        VAR Top5 = TOPN(5, CoTinh, [So_ban_ghi], DESC)",
              "        RETURN DIVIDE(",
              "            SUMX(Top5, [So_ban_ghi]),",
              "            CALCULATE([So_ban_ghi], ban_ghi[province] <> BLANK())",
              "        )"
            ],
            "formatString": "0%",
            "lineageTag": "1597b3ac-3f5b-4fb5-8992-7b6f64abdbb3"
          },
          {
            "name": "Top5_tinh_ten",
            "expression": [
              "VAR CoTinh = FILTER(VALUES(ban_ghi[province]), NOT ISBLANK(ban_ghi[province]))",
              "        VAR Top5 = TOPN(5, CoTinh, [So_ban_ghi], DESC)",
              "        RETURN CONCATENATEX(Top5, ban_ghi[province], \", \", [So_ban_ghi], DESC)"
            ],
            "lineageTag": "efc9ed32-131b-4dc5-8823-a7c1c8a97547"
          },
          {
            "name": "Ten_trang1",
            "expression": "\"Phân tích phân bố không gian và thành phần loài thực vật được ghi nhận\"",
            "lineageTag": "24ffd50a-9517-4074-8bad-f8e841eb0f7d"
          },
          {
            "name": "Ten_trang2",
            "expression": "\"Phân tích xu hướng và cơ cấu nguồn ghi nhận theo thời gian (2020–2026)\"",
            "lineageTag": "77f1d04e-b25b-4643-acd5-ae96dabf2d92"
          },
          {
            "name": "Ten_trang3",
            "expression": "\"Đánh giá mức độ bảo tồn và khoảng trống đánh giá IUCN của loài nguy cấp\"",
            "lineageTag": "bfe702e0-3e53-48bb-b69d-303a7281555f"
          },
          {
            "name": "Tieu_de_trang1",
            "expression": [
              "\"Năm tỉnh đầu bảng (\" & [Top5_tinh_ten] & \") chiếm \" &",
              "        FORMAT([Top5_tinh_ty_le], \"0%\") & \" bản ghi có tỉnh.\""
            ],
            "lineageTag": "dfba0bc8-5191-45c7-a596-7953ece4d22a"
          },
          {
            "name": "Tieu_de_trang2",
            "expression": [
              "VAR Nam = FILTER(ALLSELECTED(ban_ghi[year]), ban_ghi[year] <= 2025)",
              "        VAR NamDau = MINX(Nam, ban_ghi[year])",
              "        VAR NamCuoi = MAXX(Nam, ban_ghi[year])",
              "        VAR NamDinh = MAXX(TOPN(1, Nam, [So_ban_ghi], DESC), ban_ghi[year])",
              "        VAR Gap = DIVIDE(",
              "            CALCULATE([So_ban_ghi], ban_ghi[year] = NamDinh),",
              "            CALCULATE([So_ban_ghi], ban_ghi[year] = NamDau)",
              "        )",
              "        RETURN IF(",
              "            NamDau = NamCuoi,",
              "            \"Chọn từ hai năm trở lên để xem xu hướng.\",",
              "            \"Ghi nhận tăng gấp \" & FORMAT(Gap, \"0.0\", \"vi-VN\") & \" lần (\" & NamDau & \" đến \" & NamDinh &",
              "            \"), nhưng tiêu bản chỉ còn \" &",
              "            FORMAT(CALCULATE([Ty_le_tieu_ban], ban_ghi[year] = NamCuoi), \"0%\") &",
              "            \" bản ghi năm \" & NamCuoi & \".\"",
              "        )"
            ],
            "lineageTag": "29ce7cff-ca61-4e7b-bb1a-38cb69604183"
          },
          {
            "name": "Tieu_de_trang3",
            "expression": [
              "\"Chỉ \" & FORMAT([Ty_le_nguy_cap], \"0%\") & \" bản ghi là loài nguy cấp, và \" &",
              "        FORMAT([Ty_le_chua_danh_gia], \"0%\") & \" chưa được đánh giá IUCN.\""
            ],
            "lineageTag": "89b1f56d-a168-492b-86fb-14d1ea93ef8e"
          }
        ],
        "partitions": [
          {
            "name": "ban_ghi",
            "mode": "import",
            "source": {
              "expression": [
                "let",
                "    DuongDan = \"C:\\DS111\\miniseminar\\vn_plants_clean.csv\",",
                "    Nguon = Csv.Document(File.Contents(DuongDan), [Delimiter = \",\", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),",
                "    TieuDe = Table.PromoteHeaders(Nguon, [PromoteAllScalars = true]),",
                "",
                "    // Ô trống trong CSV thành null để Power BI coi là Blank (nếu không, DISTINCTCOUNT đếm thêm một giá trị rỗng)",
                "    LamSach = Table.ReplaceValue(TieuDe, \"\", null, Replacer.ReplaceValue, Table.ColumnNames(TieuDe)),",
                "",
                "    // Ép kiểu; culture en-US để dấu chấm thập phân được đọc đúng",
                "    Kieu = Table.TransformColumnTypes(LamSach, {",
                "        {\"gbifID\", Int64.Type}, {\"year\", Int64.Type}, {\"month\", Int64.Type}, {\"day\", Int64.Type},",
                "        {\"decimalLatitude\", type number}, {\"decimalLongitude\", type number},",
                "        {\"coordinateUncertaintyInMeters\", type number},",
                "        {\"is_assessed\", type logical}, {\"is_threatened\", type logical},",
                "        {\"species_level\", type logical}, {\"coord_imprecise\", type logical}",
                "    }, \"en-US\"),",
                "",
                "    // Nhãn tiếng Việt và cột thứ tự để sắp xếp trên biểu đồ",
                "    NamNhan = Table.AddColumn(Kieu, \"nam_nhan\", each if [year] = 2026 then \"2026*\" else Text.From([year]), type text),",
                "    ThangNhan = Table.AddColumn(NamNhan, \"thang_nhan\", each if [month] = null then null else \"T\" & Text.From([month]), type text),",
                "    LoaiBanGhi = Table.AddColumn(ThangNhan, \"loai_ban_ghi\", each",
                "        if [source_type] = \"Quan sat\" then \"Quan sát\"",
                "        else if [source_type] = \"Tieu ban\" then \"Tiêu bản\"",
                "        else \"Khác\", type text),",
                "    LoaiThuTu = Table.AddColumn(LoaiBanGhi, \"loai_ban_ghi_thu_tu\", each",
                "        if [loai_ban_ghi] = \"Quan sát\" then 1 else if [loai_ban_ghi] = \"Tiêu bản\" then 2 else 3, Int64.Type),",
                "    IucnThuTu = Table.AddColumn(LoaiThuTu, \"iucn_thu_tu\", each",
                "        List.PositionOf({\"Chưa đánh giá\", \"Ít quan ngại\", \"Nguy cấp\", \"Thiếu dữ liệu\", \"Khác\"}, [iucn_group]) + 1, Int64.Type),",
                "",
                "    // Tên địa điểm kèm quốc gia, để bản đồ Bing xác định đúng tỉnh của Việt Nam",
                "    DiaDiem = Table.AddColumn(IucnThuTu, \"dia_diem\", each",
                "        if [province] = null then null else [province] & \", Việt Nam\", type text)",
                "in",
                "    DiaDiem"
              ],
              "type": "m"
            }
          }
        ]
      }
    ]
  }
}